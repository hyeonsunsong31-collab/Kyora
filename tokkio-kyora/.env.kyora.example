# Kyora overlay environment for the Tokkio ACE controller (src/llm-rag).
# These are FALLBACKS: src/bot.py (from tokkio-kyora/src/bot.kyora.py) reads
# configs/config.yaml -> KyoraProcessor.events_url / token first and only uses
# these variables when those are empty.
#
# How they get into the container: the vendored entrypoint.sh runs
# `export $(cat .env | xargs)` and bot.py calls load_dotenv(), so a .env next to
# entrypoint.sh (/app/.env in the ace-controller container) is picked up at
# import time. The .env is NOT hot-reloaded by uvicorn --reload; it is re-read
# when bot.py is reloaded (uploading src/bot.py last triggers that) or when the
# pod restarts. Alternatively set them as container env on the ace-controller
# deployment. The upload script never writes this file for you.

# Kyora base URL as reachable FROM THE CLUSTER NETWORK (not localhost of your laptop).
# Kyora must run with the UI exposed: `kyora hub` (or `kyora serve --host 0.0.0.0`)
# AND settings hub.expose_ui=true, otherwise /api/events answers 403 to non-loopback clients.
KYORA_EVENTS_URL=http://192.168.1.20:8765

# Kyora hub token (keys.json -> hub.token; printed by `kyora hub`). Sent as Authorization: Bearer.
KYORA_HUB_TOKEN=replace-with-the-token-printed-by-kyora-hub

# Secrets the vendored bot.py reads (unchanged by Kyora). NVIDIA_API_KEY is the same
# NVIDIA API Catalog key Kyora uses for Nemotron (config/keys.json -> nvidia.nemotron.api_key).
# In a cluster deployment these come from the k8s secrets nvidia-api-key-secret /
# elevenlabs-api-key-secret / openai-key-secret (mounted under /secrets by the chart).
# NVIDIA_API_KEY=nvapi-...
# ELEVENLABS_API_KEY=...
# OPENAI_API_KEY=unused-but-must-be-non-empty-for-the-one-click-scripts
